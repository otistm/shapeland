{
  "name": "shapeland",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shapeland — an open world adventure RPG in the browser.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prove": "tsx packages/tools/src/prove-cli.ts",
    "replay": "tsx packages/tools/src/replay-cli.ts",
    "corpus": "tsx packages/tools/src/record-corpus.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1"
  }
}
